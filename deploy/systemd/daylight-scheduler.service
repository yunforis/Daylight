[Unit]
Description=Daylight scheduler
After=network-online.target postgresql.service redis-server.service rabbitmq-server.service
Wants=postgresql.service redis-server.service rabbitmq-server.service

[Service]
Type=simple
WorkingDirectory=/opt/daylight/app
EnvironmentFile=/opt/daylight/.env
Environment=DAYLIGHT_HEALTH_PORT=3003
ExecStart=/usr/local/bin/node server/scheduler.js 
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=60
LimitNOFILE=65535
StandardOutput=append:/var/log/daylight/scheduler.log
StandardError=append:/var/log/daylight/scheduler.log

[Install]
WantedBy=multi-user.target
