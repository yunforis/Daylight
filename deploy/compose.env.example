# Copy outside the repository or to a gitignored file; use hex passwords so URLs need no escaping.
# Generate independent values with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-independent-hex-password
REDIS_PASSWORD=replace-with-independent-hex-password
RABBITMQ_PASSWORD=replace-with-independent-hex-password
MINIO_ROOT_USER=daylight-local
MINIO_ROOT_PASSWORD=replace-with-independent-hex-password
DAYLIGHT_JWT_SECRET=replace-with-at-least-32-random-characters
DAYLIGHT_OSS_BUCKET=daylight
DAYLIGHT_IMAGE=daylight:local
DAYLIGHT_BIND_ADDRESS=127.0.0.1
DAYLIGHT_PORT=3000
DAYLIGHT_PUBLIC_BASE_URL=http://localhost:3000
DAYLIGHT_ADMIN_EMAILS=admin@example.com
DAYLIGHT_SYSTEM_MAIL_ENABLED=0
DAYLIGHT_SYSTEM_MAIL_HOST=
DAYLIGHT_SYSTEM_MAIL_PORT=465
DAYLIGHT_SYSTEM_MAIL_SECURE=1
DAYLIGHT_SYSTEM_MAIL_USER=
DAYLIGHT_SYSTEM_MAIL_PASS=
DAYLIGHT_SYSTEM_MAIL_FROM=
# Per-job execution guard for the worker. A mailbox sync walks every message through the
# model inside one job, so a full mailbox on a slow reasoning model needs more than the
# 300s in-code default. The job lease is renewed by heartbeat, so raising this is safe.
DAYLIGHT_JOB_TIMEOUT_MS=900000

# Debian mirror used while building the runtime image. Mainland-China hosts should use
# mirrors.aliyun.com (or another reachable mirror); the default Debian Fastly CDN can hang on
# dual-stack hosts, so the build also forces IPv4 for apt.
DEBIAN_MIRROR=mirrors.aliyun.com

# Loopback-only host ports for dependency tooling. They exist so single-node operators can run
# migrations, scripts/verify-*.mjs and metrics collectors from the host without exposing any
# dependency to the network. Change them if the host already uses these ports.
DAYLIGHT_PG_HOST_PORT=15432
DAYLIGHT_REDIS_HOST_PORT=16379
DAYLIGHT_MQ_HOST_PORT=15673
DAYLIGHT_MQ_UI_HOST_PORT=15674
DAYLIGHT_MINIO_HOST_PORT=19000
DAYLIGHT_MINIO_CONSOLE_HOST_PORT=19001
